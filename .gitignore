# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
.next/
out/
coverage/
*.tsbuildinfo

# The SMTP submission password is a deployment file, not a repository file.
# `docker compose` mounts ./infra/secrets/smtp_password into alertmanager and the
# api; infra/secrets/README.md says how to create it. Ignored so a `git add -A`
# on this checkout cannot commit a live credential.
infra/secrets/*
!infra/secrets/README.md

# Environment & secrets
.env
.env.*
!.env.example
*.pem
*.key

# Logs
logs/
*.log
npm-debug.log*

# Prisma
packages/database/prisma/*.db

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Test artifacts
playwright-report/
test-results/

# Docker volumes (if mounted into the repo)
.pgdata/
.minio/
.redis/
# Python
__pycache__/
*.py[cod]

# Cerulean Vault token copies (data/vault/token/<product>.token) — live credentials.
data/vault/token/
data/vault/init/
data/vault/file/
