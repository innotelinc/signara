# ==========================================================================
# Signara — environment configuration template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ==========================================================================

# --- General ---------------------------------------------------------------
NODE_ENV=development
APP_NAME=Signara
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
WEB_URL=http://localhost:3000
AUTH_URL=http://localhost:9100
IMAGE_TAG=latest
SIGNARA_API_IMAGE=ghcr.io/innotelinc/signara-api:latest
SIGNARA_WEB_IMAGE=ghcr.io/innotelinc/signara-web:latest
WEB_BIND_ADDRESS=127.0.0.1
WEB_BIND_PORT=3000
API_BIND_ADDRESS=127.0.0.1
API_BIND_PORT=8000
AUTHENTIK_BIND_ADDRESS=127.0.0.1
AUTHENTIK_BIND_PORT=9100
AUTHENTIK_HTTPS_BIND_PORT=9443

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=signara
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=signara
DATABASE_URL='postgresql://signara:change-me-postgres@localhost:5432/signara?schema=public'

# --- Redis / BullMQ --------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis
REDIS_URL=redis://:change-me-redis@localhost:6379

# --- Object storage (the "storage profile", docs/Roadmap.md W3) -------------
# Signara's document store. Two stores appear on purpose:
#
#   SIGNARA_S3_*   the live profile, and what the API actually uses. Currently
#                  the estate's onyx-objectstore. Reached over the host address
#                  because the edge reaches that store the same way, and a
#                  presigned URL has to be signable for both hops.
#   S3_*           MinIO's own root credentials, deliberately left in place so
#                  the retired store can be started again for rollback
#                  (`--profile legacy-storage`) with its credentials intact.
#
# Changing stores is a change here, not a code change — copy first, which
# verifies every object byte for byte before anything is pointed at it:
#   node scripts/migrate-object-store.mjs --apply
SIGNARA_S3_ENDPOINT=http://192.168.1.46:2090
SIGNARA_S3_REGION=us-east-1
SIGNARA_S3_BUCKET=signara-documents
SIGNARA_S3_ACCESS_KEY=change-me-onyx
SIGNARA_S3_SECRET_KEY=change-me-onyx
SIGNARA_S3_FORCE_PATH_STYLE=true
SIGNARA_S3_PUBLIC_ENDPOINT=https://storage.signara.innotel.us

# --- MinIO (retired primary — rollback only) --------------------------------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=signara-documents
S3_ACCESS_KEY=signara
S3_SECRET_KEY=change-me-minio
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_ENDPOINT=https://storage.signara.innotel.us

# --- Meilisearch -----------------------------------------------------------
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_API_KEY=change-me-meilisearch

# --- Authentik (OIDC/OAuth2 identity provider) -----------------------------
# Shared Authentik is external by default. Set AUTHENTIK_MODE=local and use
# `docker compose --profile authentik ...` only when this host should run the
# local replacement.
AUTHENTIK_MODE=remote
OIDC_ISSUER_URL=https://auth.signara.innotel.us/application/o/signara/
OIDC_CLIENT_ID=signara-web
OIDC_CLIENT_SECRET=change-me-oidc-client-secret
OIDC_JWKS_URL=http://localhost:9100/application/o/signara/jwks/
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
OIDC_AUTHORIZATION_URL=http://localhost:9100/application/o/authorize/
OIDC_TOKEN_URL=http://localhost:9100/application/o/token/
OIDC_USERINFO_URL=http://localhost:9100/application/o/userinfo/
OIDC_SCOPES="openid profile email groups"
IDP_ADMIN_GROUP=signara-admins

# Production wiring against Cerulean's shared Authentik (this deployment):
#   OIDC_ISSUER_URL=https://auth.cerulean.innotel.us/application/o/signara/
#   OIDC_JWKS_URL=https://auth.cerulean.innotel.us/application/o/signara/jwks/
#   OIDC_REDIRECT_URI=https://api.signara.innotel.us/api/v1/auth/callback
#   OIDC_AUTHORIZATION_URL=https://auth.cerulean.innotel.us/application/o/authorize/
#   OIDC_TOKEN_URL=https://auth.cerulean.innotel.us/application/o/token/
#   OIDC_USERINFO_URL=https://auth.cerulean.innotel.us/application/o/userinfo/
# (The OIDC provider "Signara" / client `signara-web` and the `signara-admins`
# group live in Cerulean; see the cerulean repo's scripts.)

# Authentik runtime secrets — used only by the optional local profile.
AUTHENTIK_SECRET_KEY=change-me-authentik-secret
AUTHENTIK_DB_PASSWORD=change-me-authentik-db
AUTHENTIK_BOOTSTRAP_EMAIL=admin@signara.innotel.us
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me-authentik-bootstrap

# --- Auth / Security -------------------------------------------------------
# Comma-separated extra browser origins allowed to call the API (added on top
# of WEB_URL/APP_URL, the apex domain of those hosts, and localhost:3000).
# Unset → derived automatically. Needed for every hostname the app is served
# from that is not WEB_URL/APP_URL or their apex — on this deployment the
# legacy public URL folded onto this app:
#   CORS_ORIGINS=https://sign.innotel.us
CORS_ORIGINS=
JWT_ACCESS_SECRET=change-me-jwt-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret
JWT_REFRESH_TTL=30d
CRYPTO_MASTER_KEY=change-me-32-byte-master-key-0000000000
SESSION_COOKIE_SECURE=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
CSP_REPORT_URI=http://localhost:8000/api/v1/audit/csp-report

# --- Certificates (advanced signature integrations) ------------------------
# ACME (RFC 8555) — point at any ACME directory (Let's Encrypt, step-ca, internal CAs)
ACME_DIRECTORY_URL=
ACME_CONTACT_EMAIL=
# dns-01 automation: "cloudflare" uses CF_API_TOKEN below
ACME_DNS_PROVIDER=
# expose http-01 at <API_URL>/.well-known/acme-challenge (may be required by some CAs)
ACME_HTTP_CHALLENGE=false
# Cerulean (managed certificate-backed signatures)
CERULEAN_API_URL=https://api.cerulean.com/v1
CERULEAN_API_KEY=

# Cerulean DNS / NGINX automation (local sibling service)
# Run `./setup.sh --with-cerulean` to reconcile these records, hosts, and TLS.
CERULEAN_DNS_API_URL=http://localhost:3003
CERULEAN_ADMIN_PASSWORD=
CERULEAN_BASE_DOMAIN=signara.innotel.us
CERULEAN_ZONE=innotel.us
# LAN address used only by NPM to reach Signara services; never publish it in DNS.
CERULEAN_LAN_IP=
# Last verified public WAN IPv4 address used for every Signara DNS A record.
# Normal provisioning rediscovers and validates the current WAN IP every run,
# then persists the result here. It never publishes LAN or Docker addresses.
CERULEAN_WAN_IP=
CERULEAN_WAN_DISCOVERY_URL=https://api.ipify.org
CERULEAN_CERT_TIMEOUT=900
CERULEAN_RENEW_DAYS=30
CERULEAN_AUTO_PROVISION=false
# Cloudflare API token (used only by the legacy direct NPM/ACME automation)
CF_API_TOKEN=
# Enterprise PKI / internal CA: optional provisioner script contract
# (see docs/AdministrationGuide.md — Certificates)
INTERNAL_PKI_PROVISION_SCRIPT=

# --- Billing (optional) ----------------------------------------------------
# LEGACY: leave empty when Magnate owns billing (the default). Magnate is
# the single billing platform for the entire Innotel ecosystem.
# See https://github.com/innotelinc/magnate
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_ENABLED=false

# --- Magnate (RevenueOps) — billing & entitlements -----------------------
# Innotel Platform Stack: Signara does NOT own billing — Magnate does.
# Point at the shared Magnate instance for subscription checks and
# entitlement gating. Leave empty when running standalone (no billing).
MAGNATE_PUBLIC_URL=

# --- Notifications / SMTP --------------------------------------------------
# SMTP_HOST unset → email workers record state without sending (dev mode).
# SMTP_HOST set → signing invites/reminders and notification emails are delivered.
SMTP_HOST=
SMTP_PORT=587
# 'true' = implicit TLS (SMTPS, usually port 465). Unset → auto: port 465 implies TLS,
# otherwise STARTTLS (usually port 587).
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Signara <no-reply@signara.innotel.us>"
SMS_PROVIDER=
SMS_API_KEY=

# --- Monitoring ------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
PROMETHEUS_PUSHGATEWAY=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=signara-api
SENTRY_DSN=

# --- Backup ----------------------------------------------------------------
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=signara-backups
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RUN_ON_START=false
BACKUP_REQUIRE_REMOTE=false
BACKUP_ONCE=false
# Addresses that mean "this host", comma-separated. The backup job runs in a
# container and cannot see the host's LAN address, so it compares the mirror
# endpoint against this list to prove the mirror is somewhere else. Until a
# mirror resolves outside this list, BackupIsLocalOnly keeps alerting.
BACKUP_LOCAL_ADDRESSES=
# ─── Cerulean Vault (SecretOps) ────────────────────────────────────
# The platform's only secret store: HashiCorp Vault (KV v2), hosted by
# Cerulean. Values live there, and .env may name one with a reference:
#
#   AUTHENTIK_CLIENT_SECRET=vault://cerulean/signara#AUTHENTIK_CLIENT_SECRET
#
# Resolution is the operator's step, not this stack's: nothing here resolves a
# `vault://` value at runtime, so Compose would pass the literal string to the
# container. Write the resolved value into the gitignored .env (see
# docs/stack.md) and treat a reference left in place as a deployment error.
#
# Cerulean's Vault bootstrap mints this stack's path-scoped token
# (VAULT_PRODUCT_TOKENS=signara there) and writes it to
# ./data/vault/token/signara.token; copy that file in, then move any plaintext
# values across with scripts/vault-migrate.py:
#
#   VAULT_ADDR=http://<cerulean-host>:8200 \
#     VAULT_TOKEN_FILE=./data/vault/token/signara.token \
#     VAULT_PREFIX=cerulean VAULT_PATH=signara \
#     python3 scripts/vault-migrate.py --from-env-file .env \
#       --keys AUTHENTIK_CLIENT_SECRET,STRIPE_SECRET_KEY
VAULT_ADDR=
VAULT_TOKEN_FILE=./data/vault/token/signara.token
VAULT_PREFIX=cerulean
VAULT_PATH=signara
VAULT_TOKEN=
VAULT_NAMESPACE=
VAULT_SKIP_VERIFY=
VAULT_CACERT=
